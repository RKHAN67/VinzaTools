-      const scoreDiff = preferredVideoScore(a.quality) - preferredVideoScore(b.quality);
-      if (scoreDiff !== 0) return scoreDiff;
-      return parseInt(b.quality, 10) - parseInt(a.quality, 10);
-    })
-    .slice(0, 4);
